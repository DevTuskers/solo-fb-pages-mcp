# Meta app (App settings > Basic, Facebook Login for Business > Configurations)
FB_APP_ID=
FB_APP_SECRET=
FB_LOGIN_CONFIG_ID=
# true = build a classic scope= login URL instead of config_id
FB_LOGIN_USE_SCOPE=false
GRAPH_API_VERSION=v26.0

# Public HTTPS URL of this server (OAuth redirect = $PUBLIC_BASE_URL/oauth/callback)
PUBLIC_BASE_URL=http://localhost:8080
# openssl rand -hex 32
MCP_API_KEY=
ADMIN_PASSWORD=
# openssl rand -base64 32 | tr '+/' '-_'   (or: uv run solo-fb-pages-mcp --gen-key)
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///./solo-fb-pages-mcp.db

READ_ONLY=false
REQUIRE_CONFIRM_DESTRUCTIVE=true
# comma-separated Page IDs; empty = every connected Page
ALLOWED_PAGE_IDS=
# allow image/video arguments to be server-local file paths (local --stdio dev only)
ALLOW_LOCAL_FILES=false
WEBHOOK_VERIFY_TOKEN=
